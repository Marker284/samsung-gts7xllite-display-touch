# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.
# Samsung Galaxy Tab S7 FE LTE (SM-T735 / SM-T736B), SM7225 "lagoon"/lito.
# The Wi-Fi variant (SM-T733 / SM-T730, gts7fewifi) is SM7325 and is a separate port.

deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy Tab S7 FE LTE"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-gts7xllite"
deviceinfo_year="2021"
deviceinfo_dtb="qcom/sm7225-samsung-gts7xllite"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_external_storage="true"
# Panel is 2560x1600 but mounted in portrait: the DT framebuffer is 1600x2560.
deviceinfo_screen_width="1600"
deviceinfo_screen_height="2560"
# TODO(verify): no DSI/dispcc yet, display comes up via simple-framebuffer only.
# Set deviceinfo_drm="true" once the HX83121 panel driver and dispcc are enabled.

# Bootloader related
# Values taken from the stock boot.img of T735XXS9DYF1 (see notes/hardware.md).
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="2"
deviceinfo_flash_pagesize="4096"
deviceinfo_flash_offset_base="0x00000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00000000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_offset_dtb="0x01f00000"

# No flash method: Samsung download mode. boot.img is packed into a tar and written
# with odin4 by hand (heimdall fails on this family, see notes/flashing.md).
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_flash_heimdall_partition_vbmeta="VBMETA"
