From: Mark <mark@localhost>
Date: Sat, 3 Oct 2026 21:32:53 +0500
Subject: [PATCH 3/4] drivers: add FT8203 panel and touchscreen Kconfig and Makefile entries

Add config options and build rules for:
- DRM_PANEL_FOCALTECH_FT8203_TS124QDM: FocalTech FT8203 TS124QDM WQXGA panel
- TOUCHSCREEN_FOCALTECH_FT8203: FocalTech FT8203 SPI TDDI touchscreen

Signed-off-by: Mark <mark@localhost>
---
 drivers/gpu/drm/panel/Kconfig      | 11 +++++++++++
 drivers/gpu/drm/panel/Makefile     |  1 +
 drivers/input/touchscreen/Kconfig  | 12 ++++++++++++
 drivers/input/touchscreen/Makefile |  1 +
 4 files changed, 25 insertions(+)

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index c3a113d..d5ef76c 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -187,6 +187,17 @@ config DRM_PANEL_FEIYANG_FY07024DI26A30D
 	  handling of power supplies or control signals. It implements automatic
 	  backlight handling if the panel is attached to a backlight controller.
 
+config DRM_PANEL_FOCALTECH_FT8203_TS124QDM
+	tristate "FocalTech FT8203 TS124QDM WQXGA panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	help
+	  Say Y here if you want to enable support for the 12.4" 1600x2560
+	  WQXGA TS124QDM panel with a FocalTech FT8203 driver IC, as found in
+	  the Samsung Galaxy Tab S7 FE. The panel runs compressed (DSC 1.1).
+
 config DRM_PANEL_HIMAX_HX8279
 	tristate "Himax HX8279-based panels"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 7258e72..419c8f9 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -19,6 +19,7 @@ obj-$(CONFIG_DRM_PANEL_FEIXIN_K101_IM2BA02) += panel-feixin-k101-im2ba02.o
 obj-$(CONFIG_DRM_PANEL_FEIYANG_FY07024DI26A30D) += panel-feiyang-fy07024di26a30d.o
 obj-$(CONFIG_DRM_PANEL_FOCALTECH_OTA7290B) += panel-focaltech-ota7290b.o
+obj-$(CONFIG_DRM_PANEL_FOCALTECH_FT8203_TS124QDM) += panel-ft8203-ts124qdm-wqxga.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX8279) += panel-himax-hx8279.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX83102) += panel-himax-hx83102.o
 obj-$(CONFIG_DRM_PANEL_HIMAX_HX83112A) += panel-himax-hx83112a.o
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 1ba2d3b..3320c18 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1414,6 +1414,18 @@ config TOUCHSCREEN_ZINITIX
 	  To compile this driver as a module, choose M here: the
 	  module will be called zinitix.
 
+config TOUCHSCREEN_FOCALTECH_FT8203
+	tristate "FocalTech FT8203 touchscreen"
+	depends on SPI_MASTER
+	depends on DRM || DRM=n
+	select DRM_PANEL
+	help
+	  Say Y here to enable support for the FocalTech FT8203 TDDI
+	  touchscreen controller, as found in the Samsung Galaxy Tab S7 FE.
+
+	  To compile this driver as a module, choose M here: the module will be
+	  called focaltech-ft8203.
+
 config TOUCHSCREEN_HIMAX_HX83112B
 	tristate "Himax hx83112b touchscreen driver"
 	depends on I2C
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index ef88b90..9f7126a 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -119,4 +119,5 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
 obj-$(CONFIG_TOUCHSCREEN_IQS7211)	+= iqs7211.o
 obj-$(CONFIG_TOUCHSCREEN_ZINITIX)	+= zinitix.o
+obj-$(CONFIG_TOUCHSCREEN_FOCALTECH_FT8203)	+= focaltech-ft8203.o
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
-- 
